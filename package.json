{
  "name": "avfreelance-automation",
  "version": "1.0.0",
  "description": "AVfreelance external automation engine — Vercel serverless functions + cron jobs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "lint": "eslint . --ext .js,.ts",
    "test": "node --test",
    "check:routes": "node scripts/check-route-parity.mjs",
    "check:handlers": "node scripts/check-handler-imports.mjs",
    "dry-run:manual": "node scripts/manual-dry-run.mjs",
    "check:zero-dispatch": "node scripts/check-zero-dispatch-foundation.mjs"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@vercel/node": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.x"
  }
}
